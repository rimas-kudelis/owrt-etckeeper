@@ -59,7 +59,7 @@ if [ "$VCS" = git ] && [ -d .git ]; then
 	if [ -n "$USER" ]; then
 		# Use user.name and user.email from the gitconfig belonging
 		# to USER.
-		USER_HOME="$(getent passwd "$USER" | cut -d: -f6)"
+		USER_HOME="$( (getent passwd "$USER" 2>/dev/null || grep "^$USER:" /etc/passwd) | cut -d: -f6)"
